<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ddango">

    <select id="getAllTest" resultType="com.yj.secondproject.TestDTO">
            select * from Test
    </select>


    <!-- USERS 회원 관리 -->

    <!-- 1. 회원가입 -->
    <insert id="insertUser">
        insert into USERS (u_id, u_login_id, u_password, u_nickname, u_email) values (USERS_SEQ.NEXTVAL, #{uLoginId}, #{uPassword}, #{uNickname}, #{uEmail})
    </insert>


</mapper>